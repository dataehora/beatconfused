				(thickness 0.2104)
				(material "7628")
				(epsilon_r 4.4)
				(loss_tangent 0.02)
			)
			(layer "In1.Cu"
				(type "copper")
				(thickness 0.0152)
			)
			(layer "dielectric 2"
				(type "core")
				(thickness 0.6)
				(material "FR4 NP-155F")
				(epsilon_r 4.36)
				(loss_tangent 0.02)
