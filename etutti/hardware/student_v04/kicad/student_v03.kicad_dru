(version 1)
# eTutti Viaggio MicroMod -- custom rules (written by build_board.py, SPEC v2.3 step M2)
# Every number carries its unit; no rule names the "Default" class.
(rule "Vias 0,5 / furo 0,3 em todas as classes"
    (condition "A.Type == 'via'")
    (constraint via_diameter (min 0.5mm))
    (constraint hole_size (min 0.3mm)))
(rule "Sinais: minimo 0,15 (afinacao na entrada de pinos finos)"
    (condition "A.Type == 'track' && A.NetClass != 'USB' && A.NetClass != 'Corrente'")
    (constraint track_width (min 0.15mm) (opt 0.2mm)))
(rule "USB: so em B.Cu (par de ponta a ponta no fundo, sem vias, sobre a ilha de GND da In2)"
    (condition "A.NetClass == 'USB' && A.Type == 'track' && A.Layer != 'B.Cu'")
    (constraint disallow track))
(rule "USB: 0,2 mm, vao do par >= 0,127"
    (condition "A.NetClass == 'USB' && A.Type == 'track'")
    (constraint track_width (min 0.19mm) (opt 0.2mm))
    (constraint diff_pair_gap (min 0.127mm)))
(rule "USB: 0,25 mm de qualquer outra rede (a ilha de cobre de GND fica de fora), fora dos patios do J201, U201 e J101"
    (condition "A.NetClass == 'USB' && B.NetClass != 'USB' && A.Type == 'track' && B.Type != 'Zone' && !A.intersectsCourtyard('J201') && !A.intersectsCourtyard('U201') && !A.intersectsCourtyard('J101')")
    (constraint clearance (min 0.25mm)))
(rule "Corrente: minimo 0,8 fora dos patios de E1, E3, E4, E6, A1 e J101"
    (condition "A.Type == 'track' && A.NetClass == 'Corrente' && !A.intersectsCourtyard('J201') && !A.intersectsCourtyard('U202') && !A.intersectsCourtyard('U204') && !A.intersectsCourtyard('J202') && !A.intersectsCourtyard('U501') && !A.intersectsCourtyard('J101')")
    (constraint track_width (min 0.8mm)))
(rule "Corrente: afinacao na entrada dos pinos (patios)"
    (condition "A.Type == 'track' && A.NetClass == 'Corrente' && !(!A.intersectsCourtyard('J201') && !A.intersectsCourtyard('U202') && !A.intersectsCourtyard('U204') && !A.intersectsCourtyard('J202') && !A.intersectsCourtyard('U501') && !A.intersectsCourtyard('J101') && !A.intersectsCourtyard('R205') && !A.intersectsCourtyard('R206') && !A.intersectsCourtyard('R214') && !A.intersectsCourtyard('Q201') && !A.intersectsCourtyard('U201') && !A.intersectsCourtyard('C201'))")
    (constraint track_width (min 0.15mm)))
(rule "Sob o cartao MicroMod: so pecas de ate 1,9 mm (campo Cabe_sob_cartao, de Altura_mm)"
    (condition "A.Type == 'Footprint' && A.Layer == 'B.Cu' && A.intersectsArea('cartao_MicroMod') && A.Reference != 'J101' && A.Reference != 'H101'")
    (constraint assertion "A.getField('Cabe_sob_cartao') == 'sim'"))
