	(text "E · Energia: USB-C -> PTC -> BQ24075 (USB500, 0,4 A, NTC) -> VSYS -> TPS63001 (3,3 V)." (exclude_from_sim no) (at 15 18 0) (effects (font (size 2 2)) (justify left)) (uuid "f621496a-e286-59ae-80dd-529c5e5a1ad5"))
	(text "SYSOFF (pull-up interno ~5 Mohm no VBAT) fica ALTO = bateria desligada. Puxado a GND por: borda do knob (C205), KEEP do firmware (Q202/Q203) ou USB (Q204)." (exclude_from_sim no) (at 15 23 0) (effects (font (size 2 2)) (justify left)) (uuid "515b9772-8acd-5204-b445-812ede13f185"))
	(text "Abrir o knob desfaz o KEEP em hardware (Q202 so conduz com a chave fechada)." (exclude_from_sim no) (at 15 28 0) (effects (font (size 2 2)) (justify left)) (uuid "7aabe591-fc5d-5d16-af5b-03e07aa8f644"))
