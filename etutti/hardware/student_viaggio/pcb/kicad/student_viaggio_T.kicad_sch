	(text "T · Teclas resistivas: 28 pentes de cobre (K01-K28) sob uma folha sensivel a pressao, 2 multiplexadores." (exclude_from_sim no) (at 15 18 0) (effects (font (size 2 2)) (justify left)) (uuid "4165293e-c1ce-5d7e-a986-e00888aef244"))
	(text "Pad 1 do pente = GND; pad 2 = entrada do mux. R601/R602 (10k ao 3,3 V) no comum de cada mux: 3,3 V solta, menos com a forca." (exclude_from_sim no) (at 15 23 0) (effects (font (size 2 2)) (justify left)) (uuid "d375707a-1424-512e-b745-34da1a2c32f4"))
