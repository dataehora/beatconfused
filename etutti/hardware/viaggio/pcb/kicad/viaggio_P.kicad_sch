	(text "P · Processador: 'Teensy 4.1 na placa' (esquema da PJRC, sem Ethernet, USB host nem cartao SD)." (exclude_from_sim no) (at 15 18 0) (effects (font (size 2 2)) (justify left)) (uuid "03036fcd-16b1-5307-93de-c17577f70b5d"))
	(text "SNVS antes de tudo (E5); PMIC_ON_REQ habilita o 3,3 V (U206); PSWITCH sobe pelo MKL02 (PTA3) depois do 3,3 V, sem RC." (exclude_from_sim no) (at 15 23 0) (effects (font (size 2 2)) (justify left)) (uuid "7fb0d3ff-9dd0-54e4-9232-24e376987d3b"))
	(text "Nunca ativar o modo seguro. Pinos 48-54 (EMC_22..29) ficam para a PSRAM; EMC_23 (G2) e SD_B1_05 (N3) sem ligacao." (exclude_from_sim no) (at 15 28 0) (effects (font (size 2 2)) (justify left)) (uuid "3d6e791f-3699-5ab3-a304-e83126796da5"))
